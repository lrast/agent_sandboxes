(version 1)
;; SCRIPT_DIR is passed by start_vm.sh via sandbox-exec -D SCRIPT_DIR=...
(deny default)

;; --------------------------------------------------------
;; 1. Core Execution & Frameworks
;; --------------------------------------------------------
;; Only the qemu binary may be exec'd (no /bin/sh, curl, etc. after an escape).
;; fork is kept for -daemonize.
(allow process-exec
    (literal "/opt/homebrew/bin/qemu-system-aarch64")
    (subpath "/opt/homebrew/Cellar/qemu"))
(allow process-fork)
(allow sysctl-read)

(allow mach-lookup
    (global-name "com.apple.logd")
    (global-name "com.apple.cfprefsd.daemon")
    (global-name "com.apple.system.notification_center")
    )

;; --------------------------------------------------------
;; POSIX Shared Memory & IPC (Required for QEMU memfd emulation)
;; --------------------------------------------------------
(allow ipc-posix-shm)
(allow ipc-posix-sem)

;; --------------------------------------------------------
;; 2. Network Restraints
;; --------------------------------------------------------
;; The only socket qemu may listen on is the hostfwd ssh listener on 127.0.0.1:2222.
;; Note: a (remote ip ...) filter on network-bind matches everything; never use it.
(allow network-bind (local tcp "localhost:2222"))
(allow network-inbound (local tcp "localhost:2222"))

(allow network-outbound (remote ip "*:*"))
(allow network-inbound (local udp "*:*"))



;; --------------------------------------------------------
;; 3. File System:
;; --------------------------------------------------------
;; Minimal allowlist
(deny file-read*)
(deny file-write*)


;; Block all read access to user home directories
;; redundent with deny default
(deny file-read* (subpath "/Users"))
(deny file-read* (subpath "/Volumes"))
(deny file-read* (subpath "/private/db"))

;; VM disks (os_base.qcow2 is opened with snapshot=on, so only read access is needed)
(allow file-read*
    (subpath (string-append (param "SCRIPT_DIR") "/disks"))
    )

;; Temp dir for qemu snapshot=on overlay (start_vm.sh sets TMPDIR to this)
(allow file-read* file-write*
    (subpath (string-append (param "SCRIPT_DIR") "/disks/tmp")))


;; dyld aborts without read of the root directory itself (found by bisecting)
(allow file-read* (literal "/"))

;; dyld shared cache, system libs, frameworks
(allow file-read*
    (subpath "/usr/lib")
    (subpath "/System/Library")
    (subpath "/System/Cryptexes")
    (subpath "/System/Volumes/Preboot/Cryptexes")
    (subpath "/private/preboot/Cryptexes")
    (subpath "/Library/Apple/System/Library")
    (subpath "/private/var/db/dyld")
    (literal "/dev/null")
    (literal "/dev/zero")
    (literal "/dev/urandom")
    (literal "/dev/random")
    (subpath "/dev/fd"))

;; Timezone / resolver / misc config read at startup
(allow file-read*
    (literal "/private/etc/localtime")
    (subpath "/var/db/timezone")
    (subpath "/private/var/db/timezone")
    (literal "/private/etc/resolv.conf")
    (literal "/private/etc/hosts")
    (literal "/private/etc/passwd")
    (literal "/private/etc/services"))

;; Slirp's DNS proxy (guest 10.0.2.3) reads the host nameserver from /etc/resolv.conf,
;; a symlink chain (/etc -> /private/etc, resolv.conf -> ../var/run/resolv.conf).
;; Following it needs the real file plus metadata on each directory (tested); without
;; these, guest DNS via 10.0.2.3 silently times out.
(allow file-read* (literal "/private/var/run/resolv.conf"))
(allow file-read-metadata
    (literal "/etc")
    (literal "/private")
    (literal "/private/etc")
    (literal "/var")
    (literal "/private/var")
    (literal "/private/var/run"))

;; QEMU binary, Homebrew dylibs, firmware
(allow file-read*
    (subpath "/opt/homebrew/Cellar")   ;; qemu + all transitive dylib deps (package files only)
    (subpath "/opt/homebrew/opt")      ;; version-stable symlinks into Cellar
    (subpath "/opt/homebrew/share/qemu")
    )

;; Metadata (stat/readlink) allowlist. Found by pruning: only the path to the qemu
;; launcher is needed (sandbox-exec stats it to exec). Everything else resolves via
;; the read rules below.
(allow file-read-metadata
    (literal "/opt")
    (literal "/opt/homebrew")
    (literal "/opt/homebrew/bin")
    (literal "/opt/homebrew/bin/qemu-system-aarch64"))

;; minimal writes
(allow file-write* 
    (literal "/dev/null")
    (literal "/dev/zero")
    (literal "/dev/urandom")
    (literal "/dev/random"))
;; /dev/hvf write rule removed (not needed on Apple Silicon). If HVF fails to
;; start, restore: (allow file-write* (literal "/dev/hvf"))

