(version 1)
(deny default)

;; --------------------------------------------------------
;; 1. Core Execution & Frameworks
;; --------------------------------------------------------
(allow process-exec* process-fork)
(allow sysctl-read)

(allow mach-lookup
    (global-name "com.apple.logd")
    (global-name "com.apple.cfprefsd.daemon")
    (global-name "com.apple.system.notification_center")
    )

;; --------------------------------------------------------
;; POSIX Shared Memory & IPC (Required for QEMU memfd emulation)
;; --------------------------------------------------------
(allow ipc-posix-shm)
(allow ipc-posix-sem)

;; --------------------------------------------------------
;; 2. Network Restraints
;; --------------------------------------------------------
;; Only allow binding to localhost port 2222
(allow network-bind (local ip "localhost:2222"))
(allow network-inbound (local ip "localhost:2222"))


;; --------------------------------------------------------
;; 3. File System:
;; --------------------------------------------------------
;; Default allow read, prevent write. There are too many files to include in read
(allow file-read*)
(deny file-write*)

;; Block all read access to user home directories
(deny file-read* (subpath "/Users"))
(deny file-read* (subpath "/Volumes"))
(deny file-read* (subpath "/private/db"))

;; Allow writing to macOS temporary and shared memory directories
(allow file-write* 
    (subpath "/tmp")
    (subpath "/private/tmp")
    (subpath "/var/folders")
    (subpath "/private/var/folders")
    (subpath "/var/tmp")
    (subpath "/private/var/tmp")
    )

(allow file-write* 
    (literal "/dev/null")
    (literal "/dev/zero")
    (literal "/dev/urandom")
    (literal "/dev/random")
    (literal "/dev/hvf"))


;; VM disks
(allow file-read* 
    (subpath "/Users/luke/Documents/activeProjects/agentSandbox/disks")
    (literal "/Users/luke/Documents/activeProjects/agentSandbox/disks/state_disk.qcow2"))

(allow file-write* 
    (literal "/Users/luke/Documents/activeProjects/agentSandbox/disks/state_disk.qcow2"))
